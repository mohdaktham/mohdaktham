# Local dev: docker-compose Postgres (docker compose up -d).
# Production: Supabase pooled connection string (port 6543, pgbouncer) from Project Settings > Database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobtracker?schema=public"

# Local dev: same as DATABASE_URL above.
# Production: Supabase DIRECT connection string (port 5432) — used only by `prisma migrate`.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/jobtracker?schema=public"

# Get free credentials at https://developer.adzuna.com/ — leave blank to run in demo/mock-data mode.
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
